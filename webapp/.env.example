# 漫画LP 自動制作 Webアプリの設定。値は各自の環境（ホスティング先の環境変数・Secret Manager）に入れ、リポジトリには入れない

# 必須
ANTHROPIC_API_KEY=            # Claude（構成・点検・採点・HTML設定）
OPENAI_API_KEY=               # 画像の生成
APP_PASSWORD=                 # 社内用ログインの共通パスワード
SECRET_KEY=                   # ログインのセッション署名用。長いランダム文字列
APP_BASE_URL=https://example.run.app   # 通知に載せるURL
DATA_DIR=/data                # 制作データの置き場（Cloud Run ならバケットをマウント）

# 通知（Chatwork）
CHATWORK_TOKEN=
CHATWORK_ROOM_ID=

# 品質・費用（省略可）
JOB_BUDGET_JPY=5000           # 1件の上限。超えたら止めて画面で確認
PASS_SCORE=80
MAX_FIX=3
PANEL_WORKERS=3               # 同時に作るコマ数
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=high
USD_JPY=150

# 見本LP・社内ルール（省略可。コンテナに入れたパス）
BENCHMARK_SITE=
HOUSE_RULES_FILE=

# 動作確認用（APIを呼ばない）
MANGA_MOCK=0
